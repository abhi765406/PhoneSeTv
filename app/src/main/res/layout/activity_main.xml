<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/primary"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HomeWatch"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Turn a spare phone into a live camera with motion alerts"
                android:textColor="#D6E4F5"
                android:textSize="13sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:elevation="3dp"
            android:layout_margin="16dp"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your name"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/nameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="e.g. Home phone, or your name"
                android:singleLine="true"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Room code"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp"/>

            <EditText
                android:id="@+id/roomInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Leave blank to generate one (Camera mode)"
                android:singleLine="true"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/generateCodeButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Generate a new room code"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:background="@android:color/transparent"
                android:layout_marginBottom="20dp"/>

            <Button
                android:id="@+id/startCameraButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="📷  Use This Phone As the Camera"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_bg"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/startViewerButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="📱  Watch a Camera Phone"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_bg"
                android:backgroundTint="@color/accent_green"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:text="Put the old phone where it can see what you want watched, pick 'Use This Phone As the Camera', and generate a code. On your main phone, pick 'Watch a Camera Phone' and enter that same code."/>

    </LinearLayout>
</ScrollView>
